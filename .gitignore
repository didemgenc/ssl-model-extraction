# Model checkpoints (~125 MB each, above GitHub's 100 MB file limit)
checkpoints/
*.pth
*.pth.tar
*.t7

# Data and generated tensors/pickles (regenerated by the scripts; see README "Data")
*.pkl
*.pt
data/

# Run outputs: keep the result tables and run logs, ignore the rest
**/outputs/*
!**/outputs/*.csv
!**/outputs/*_run.log
!**/outputs/*/log.csv
*.docx
*.tsv

# External code: clone it as described in README (mixmatch section)
mixmatch_github/

# Private revision notes
revision_notes/

__pycache__/
*.pyc
nohup.out
